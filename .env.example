# 安全配置模板：不含真实凭证。复制为本机 .env，禁止提交 .env。
HOST=0.0.0.0
PORT=5183

# 录音转写：阿里云百炼 Paraformer
ASR_PROVIDER=aliyun
ALIYUN_ASR_MODEL=paraformer-v2
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
# 可选：自定义兼容接口地址，通常留空。
DASHSCOPE_API_BASE_URL=

# Paraformer 转写和 PDF/文档处理需要私有 OSS 暂存
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# 转写稿和纯文本分析：阿里云百炼 DeepSeek
AI_ANALYSIS_PROVIDER=aliyun
TEXT_ANALYSIS_MODEL=deepseek-v4.1-flash-1017
TEXT_ANALYSIS_FALLBACK_MODEL=deepseek-v4.1-flash
# 文档和图片分析：阿里云百炼 Qwen
DOCUMENT_ANALYSIS_MODEL=qwen3.8-flash
DOCUMENT_ANALYSIS_FALLBACK_MODEL=qwen3.8-max-0902
# 可选：false 关闭模型思考，true 开启。
# DASHSCOPE_ENABLE_THINKING=false

# 办公文档和图片转 PDF：华为云市场九云图服务
YUNTU_APIG_APPCODE=
YUNTU_CONVERT_URL=https://freem2.apistore.huaweicloud.com/convert

# 可选：仅备用 paraformer-8k-v2 重采样或腾讯云处理 WebM 录音时需要。
# 若系统路径中找不到 ffmpeg，请填写本机 ffmpeg.exe 完整路径。
FFMPEG_PATH=
