          "files": 1,
          "summary": "按居住年限分层抽样，问卷控制在8分钟内；本次纪要记录问卷修订、点位观察和访谈安排，覆盖范围与结论边界仍需在下一轮复核。",
          "assignments": 3,
          "attendance": [
            {
              "name": "张伟",
              "personId": "u-1",
              "at": "2026-10-30T10:05:00+08:00",
